{
  "title": "MinIO Metrics",
  "panels": [
    {
      "type": "timeseries",
      "title": "S3 Requests",
      "targets": [
        {
          "expr": "rate(minio_s3_requests_total[1m])"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Storage Used",
      "targets": [
        {
          "expr": "minio_disk_storage_used_bytes"
        }
      ]
    }
  ]
}